# Copy to .env (never commit .env). Set the same values in Vercel > Project > Settings > Environment Variables.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://apissidevbuddy-qa.ssidecisions.com/litellm/v1
# Model IDs as listed by GET {LITELLM_BASE_URL}/models (case-sensitive)
MODEL_SMART=claude-sonnet-5-5
MODEL_FAST=claude-haiku
# Budget guard: set to false to disable live (paid) runs; cached demos keep working
LIVE_RUNS_ENABLED=true
# Optional: shared samples on the home page (Upstash Redis, free plan). Without these, sharing is hidden.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
